[Unit]
Description=Logitech H-Shifter virtueller Joystick-Treiber
After=multi-user.target

[Service]
Type=simple
User=professortee
WorkingDirectory=/home/professortee/DotFiles/Logitech-Shifter
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/professortee/DotFiles/Logitech-Shifter/shifter_driver.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
